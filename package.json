{
  "name": "ip-studio",
  "version": "0.1.0",
  "private": true,
  "description": "自媒体助手：多用户自媒体选题、成稿与口播系统",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "dev:web": "vite --config web/vite.config.js",
    "build:web": "vite build --config web/vite.config.js",
    "check": "node scripts/check.js",
    "test": "node scripts/check.js && node --test tests/*.test.js",
    "test:ui": "node tests/ui/run.mjs",
    "deploy": "bash scripts/deploy-jdcloud.sh"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "bullmq": "^5.58.5",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.6.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@tiptap/extension-color": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/vue-3": "^3.32.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "pinia": "^3.0.3",
    "playwright": "^1.64.1",
    "vite": "^7.1.5",
    "vue": "^3.5.22"
  }
}
