{
  "name": "copywriter-studio",
  "version": "0.1.0",
  "private": true,
  "description": "多用户自媒体文案生成系统 —— 给题材，出三个话题方向，选一个，生成完整文案",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "dev:web": "vite --config web/vite.config.js",
    "build:web": "vite build --config web/vite.config.js",
    "check": "node scripts/check.js",
    "test": "node scripts/check.js && node --test tests/*.test.js",
    "deploy": "bash scripts/deploy-jdcloud.sh"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "vite": "^7.1.5",
    "vue": "^3.5.22"
  }
}
