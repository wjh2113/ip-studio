# 这是模板文件，会随代码一起提交 —— 不要在这里填真实密钥。
# 复制成 .env 再填：cp .env.example .env（.env 已在 .gitignore 里）

# ── 模型通道（三选一，不配置则运行在演示模式：流程完整、内容是本地模板）──

# 方式 A：Claude（推荐）
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_MODEL=claude-opus-5

# 方式 B：任意 OpenAI 兼容接口（DeepSeek / Kimi / 通义千问 / vLLM / Ollama）
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat

# 方式 C：站内 LLM 网关（生产默认。业务侧不直连上游密钥）
# LLM_PROVIDER=gateway
# LLM_GATEWAY_URL=https://aiapimgrapi.aidigitcloud.cn
# LLM_GATEWAY_API_KEY=aam_xxx
# LLM_TENANT_ID=IP
# LLM_CAPABILITY=quality-chat
# LLM_CAPABILITY_JSON=fast-chat
# LLM_CAPABILITY_IMAGE=image-gen

# 方式 D：强制演示模式
# LLM_PROVIDER=mock

# ── 采样参数（可选，中文长文跑飞时往下调）──
# LLM_TEMPERATURE=1.0        # 正文生成，默认 1.0；1.3 以上容易语无伦次
# LLM_TEMPERATURE_JSON=0.6   # 结构化输出（选题、题材、热点、检查）
# LLM_TOP_P=0.95
# LLM_TIMEOUT_MS=120000         # 非流式调用超时
# LLM_STREAM_TIMEOUT_MS=360000  # 流式成稿超时
# LLM_MAX_INFLIGHT_PER_USER=3   # 每个用户同时最多几个生成请求
# JOB_CONCURRENCY=3             # 后台任务（出图、口播评测）全站同时跑几个
# JOB_PER_USER=2                # 每个用户同时跑几个后台任务，多的排队
# REDIS_URL=redis://127.0.0.1:6379   # BullMQ 用的 Redis。不写就连本机 6379
#
# ── 模型分档（见 server/llm.js 的 FEATURE_TIER）──
# 不配时快档和主模型一样。想省钱就给快档配一个便宜的模型：
# ANTHROPIC_MODEL_FAST=
# OPENAI_MODEL_FAST=
# 网关通道的快档是 LLM_CAPABILITY_JSON（默认 fast-chat）

# ── 管理后台 ──
# 后台在 /admin。本地第一次访问可以在页面上创建管理员。
# 生产环境请用下面两个变量在启动时写入，不要把「第一个打开 /admin 的人」变成超管。
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# 若必须走页面初始化，再配这个口令（请求里带 setup_token）
# ADMIN_SETUP_TOKEN=

# ── 注册 / 访问门 ──
# ACCESS_PASSWORD=         # 非空则关闭公开注册，前后台都只认这一个密码（与 API 网关管理台一致）
# ACCESS_USER=ip           # 这道门对应的内部用户名
# REGISTER_OPEN=1          # 设 0 关闭注册（ACCESS_PASSWORD 有值时也会关）
# REGISTER_CODE=           # 非空则注册必须带这个邀请码

# ── 服务 ──
# PORT=5177
# HOST=0.0.0.0             # 生产请设 127.0.0.1，只给 nginx 反代
# NODE_ENV=development
# TRUST_PROXY=0            # 生产在 nginx 后面设 1，限流才认真实 IP
# COOKIE_SECURE=0          # 生产 HTTPS 设 1
# DB_PATH=./data/app.db

# ── 文章配图（可选；不配置则用本地占位图，流程照样能跑通）──
# 生产请走网关，不要把万相 / SiliconFlow 上游 Key 写进本项目。
# IMAGE_PROVIDER=gateway
# LLM_GATEWAY_URL=https://aiapimgrapi.aidigitcloud.cn
# LLM_GATEWAY_API_KEY=aam_xxx
# LLM_TENANT_ID=IP
# LLM_CAPABILITY_IMAGE=image-gen
#
# 不填 IMAGE_PROVIDER 时默认演示模式。本地直连万相仅调试用：
# IMAGE_PROVIDER=dashscope
# DASHSCOPE_API_KEY=sk-xxx
# DASHSCOPE_IMAGE_MODEL=wan2.2-t2i-flash     # 也可换 wanx2.1-t2i-turbo / -plus
#
# 或走任意 OpenAI 兼容的 /v1/images/generations
# IMAGE_PROVIDER=openai
# IMAGE_API_KEY=sk-...
# IMAGE_BASE_URL=https://api.openai.com/v1
# IMAGE_MODEL=gpt-image-1
#
# 强制演示模式（调试整条链路时用，一张图都不会花钱）
# IMAGE_PROVIDER=mock

# ── 支付（微信 + 支付宝，都需要企业主体和已备案域名）──
# PAY_PROVIDER=mock            # mock = 本地假支付，把流程跑通；上线换成 wechat / alipay
# PAY_ALLOW_MOCK=0             # 生产环境默认禁用演示支付；确需演示才设 1
# PAY_NOTIFY_BASE=https://你的域名   # 回调地址前缀，必须公网可达
#
# 微信支付 v3
# WX_MCHID=            # 商户号
# WX_APPID=            # 公众号/应用 appid
# WX_CERT_SERIAL=      # 商户证书序列号
# WX_API_V3_KEY=       # APIv3 密钥（32 位）
# WX_PRIVATE_KEY=      # 商户私钥 PEM 内容
#
# 支付宝当面付
# ALI_APP_ID=
# ALI_PRIVATE_KEY=     # 应用私钥 PEM
# ALI_PUBLIC_KEY=      # 支付宝公钥 PEM（验签用，别填成自己的公钥）

# 敏感配置的加密密钥。后台填的商户私钥用它加密入库——
# 没有它，数据库里的私钥等于明文。设一个随机的长字符串，
# 并且**不要和数据库放在一起备份**（一起丢了就等于没加密）。
# SECRET_KEY=
